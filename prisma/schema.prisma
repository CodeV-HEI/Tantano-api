// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id           String        @id @default(uuid())
  username     String        @unique
  password     String
  roles        UserRole[]
  wallets      Wallet[]
  labels       Label[]
  transactions Transaction[]
  goals        Goal[]
}

model Role {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  UserRole    UserRole[]

  @@map("__role__")
}

model UserRole {
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId    String

  @@id([accountId, roleId])
  @@map("__user_role__")
}

model File {
  id   String @id @default(uuid())
  path String @unique
}

model Wallet {
  id                    String        @id @default(uuid())
  name                  String        @unique
  type                  String
  description           String?
  amount                Int
  isActive              Boolean       @default(true)
  createdAt             DateTime?     @default(now())
  haveAutomaticIncome   Boolean?      @default(false)
  automaticIncomeAmount Int?          @default(0)
  automaticIncomeDay    Int?          @default(1)
  color                 String        @default("#00ff00")
  isArchived            Boolean       @default(false)
  iconRef               String?
  transactions          Transaction[]
  accountId             String
  account               Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  goals                 Goal[]
}

model Label {
  id           String        @id @default(uuid())
  name         String
  createdAt    DateTime?     @default(now())
  updatedAt    DateTime      @updatedAt
  color        String        @default("#00ff00")
  iconRef      String?
  isArchived   Boolean       @default(false)
  transactions Transaction[]
  accountId    String
  account      Account?      @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(uuid())
  date        DateTime
  labels      Label[]
  type        String
  description String?
  amount      Int

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  walletId  String
  wallet    Wallet?  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  accountId String
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Goal {
  id           String    @id @default(uuid())
  name         String
  createdAt    DateTime? @default(now())
  updatedAt    DateTime  @updatedAt
  startingDate DateTime
  endingDate   DateTime
  color        String    @default("#00ff00")
  iconRef      String?
  isArchived   Boolean   @default(false)
  amount       Int
  accountId    String
  walletId     String?
  wallet       Wallet?   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  account      Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}
